{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCode GUI",
  "version": "0.1.8",
  "identifier": "ai.opencode.gui",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenCode GUI",
        "width": 1360,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/opencode-server"],
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "displayLanguageSelector": false,
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2NDBBQzlEMjk5ODIxRjIKUldUeUlaZ3BuYXhBUnRQdk51MDYrQnVsK01yS3J1ZThIODhxS3FUd2IvS0NGVmRnN3gyVnVtalUK",
      "endpoints": ["https://github.com/addy777-coder/opencode/releases/latest/download/latest.json"]
    }
  }
}
